{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notion-handoff-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "workers_dev": false,
  "routes": [{ "pattern": "obsidian-notion-handoff.caj.ms", "custom_domain": true }],
  "assets": {
    "directory": "../assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "AUTH_ORIGIN": "https://obsidian-notion-handoff.caj.ms" },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "OAuthSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OAuthSession"] }],
  "ratelimits": [{
    "name": "AUTH_RATE_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 20, "period": 60 }
  }],
  "observability": { "enabled": false }
}
